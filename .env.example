# ==============================================================================
# JobScout Telegram Bot - Конфигурация (.env)
# Скопируйте этот файл в .env перед запуском: copy .env.example .env (или cp .env.example .env)
# ==============================================================================

# [ОБЯЗАТЕЛЬНО] Токен вашего Telegram бота от @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# [РЕЖИМ ОКРУЖЕНИЯ]: dev (SQLite, in-memory fallback) или prod (PostgreSQL + Redis)
ENV=dev

# [РЕЖИМ ЗАПУСКА БОТА]: polling (локально) или webhook (продакшн за reverse-proxy)
BOT_MODE=polling
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_SECRET=

# [БАЗА ДАННЫХ]
# Локальная база (dev):
DATABASE_URL=sqlite+aiosqlite:///./job_hunter.db
# Продакшн PostgreSQL / PgBouncer:
# DATABASE_URL=postgresql+asyncpg://jobscout:secret_password@postgres:5432/jobscout_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
SQLITE_BUSY_TIMEOUT=5000

# [REDIS] Для FSM-хранилища, arq-воркеров, rate limiting и кэширования
# В режиме dev опционален (fallback на in-memory); в prod обязателен:
# REDIS_URL=redis://localhost:6379/0

# [АДМИНИСТРАТОРЫ] Telegram ID администраторов (через запятую)
ADMIN_IDS=123456789

# [AI / LLM ПРОВАЙДЕРЫ] (none, openai, yandex, gigachat)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
GIGACHAT_CREDENTIALS=

# [НАБЛЮДАЕМОСТЬ И МОНИТОРИНГ]
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_PORT=9090

# [МОНЕТИЗАЦИЯ И ПЛАТЕЖИ]
# Telegram Stars (валюта XTR)
STARS_PRICE_PRO=150
STARS_PRICE_TEAM=400

# Внешние платёжные шлюзы (по умолчанию выключены)
ENABLE_YOOKASSA=False
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

ENABLE_CRYPTOBOT=False
CRYPTOBOT_API_TOKEN=

# [МАТЧИНГ И ВЕСА СКОРИНГА] (Сумма весов = 1.0)
SCORE_WEIGHT_SKILLS=0.45
SCORE_WEIGHT_GRADE=0.25
SCORE_WEIGHT_EXPERIENCE=0.30
MIN_MATCH_SCORE=45
SOFT_MATCH_SCORE=35
MIN_DESIRED_MATCHES=15
RED_FLAG_STRICT_MODE=True

# [ФОНОВЫЙ МОНИТОРИНГ И НАСТРОЙКИ ПАРСИНГА]
ENABLE_AUTO_NOTIFICATIONS=True
AUTO_SEARCH_INTERVAL_MINUTES=30
SEARCH_CACHE_TTL_MINUTES=20
CIRCUIT_BREAKER_MAX_FAILURES=5
CIRCUIT_BREAKER_RESET_TIMEOUT=900

# [СИСТЕМНЫЕ НАСТРОЙКИ]
LOG_LEVEL=INFO
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
REQUEST_TIMEOUT=15
VACANCIES_PER_PAGE=5
MAX_VACANCIES_PER_SOURCE=50
THROTTLE_RATE_LIMIT=0.8

# [ВНЕШНИЕ АГРЕГАТОРЫ]
SUPERJOB_API_KEY=
ENABLE_FREELANCEHUNT=False
FREELANCEHUNT_API_TOKEN=

# [ПРОКСИ]
# PROXY_URL=http://user:pass@ru-proxy.com:8080
# PROXIES=["http://proxy1:8080","http://proxy2:8080"]
