# ==============================================================================
# JobScout Telegram Bot - Конфигурация (.env)
# Скопируйте этот файл в .env перед запуском: copy .env.example .env (или cp .env.example .env)
# ==============================================================================

# [ОБЯЗАТЕЛЬНО] Токен вашего Telegram бота, полученный у @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# [ОПЦИОНАЛЬНО] Telegram ID администраторов (через запятую)
ADMIN_IDS=123456789

# [ОПЦИОНАЛЬНО] База данных (по умолчанию локальная SQLite, для продакшена можно PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./job_hunter.db
# Пример для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/job_hunter

# [ОПЦИОНАЛЬНО] Ключ OpenAI API для продвинутого семантического анализа и AI-советов
# Если не указан, бот использует быстрый встроенный NLP-парсер без внешних затрат.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# [ОПЦИОНАЛЬНО] Фоновый мониторинг и уведомления
ENABLE_AUTO_NOTIFICATIONS=True
AUTO_SEARCH_INTERVAL_MINUTES=30
MIN_MATCH_SCORE=45
RED_FLAG_STRICT_MODE=True

# [ОПЦИОНАЛЬНО] Системные настройки и лимиты
LOG_LEVEL=INFO
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
REQUEST_TIMEOUT=15
MAX_VACANCIES_PER_SOURCE=50

# [ОПЦИОНАЛЬНО] Ключи агрегаторов
SUPERJOB_API_KEY=

# [ОПЦИОНАЛЬНО] Прокси для WAF/Geo-IP блокировок (Работа.ру и др.)
# PROXY_URL=http://user:pass@ru-proxy.com:8080 # Опциональный прокси для Работа.ру

